# Whitelist-Ansatz: Alles ignorieren, nur explizit freigegebene Dateien tracken

# Alles ignorieren
*

# Projekt-Dateien
!.gitignore
!.gitattributes
!audit.js
!browser-ui.js
!compare.js
!learn.js
!cmp-library.json
!tracking-vendors.json
!package.json
!README.md

# Asynchroner Flow-Compare (HAR-basiert)
!flow-recorder.js
!flow-analyze.js
!flow-delta.js
!flow-lib.js

# Vendored PII/Event-Parser (Snapshot aus der Tracking-Auditor-Extension)
!pii-lib/
!pii-lib/*.js

# Abgleich der Dienst-Erkennung mit Extension, Validator und Stage
!abgleich/
!abgleich/*.js
!abgleich/*.json
!abgleich/README.md

# Gemeinsamer Tracking-Klassifikations-Kern (audit.js/compare.js/flow-lib.js)
!lib/
!lib/*.js

# Tests (node --test) mit Report-Baselines und Testseiten
!test/
!test/*.js
!test/baselines/
!test/baselines/*.md
!test/browser/
!test/browser/*.js
!test-pages/
!test-pages/*.html
!test-pages/*.mjs

# Skill: Verzeichnisse stufenweise freigeben
!.claude/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/tagging-audit/
.claude/skills/tagging-audit/*
!.claude/skills/tagging-audit/skill.md
!.claude/skills/cmp-learn/
.claude/skills/cmp-learn/*
!.claude/skills/cmp-learn/skill.md
!.claude/skills/tracking-compare/
.claude/skills/tracking-compare/*
!.claude/skills/tracking-compare/skill.md
!.claude/skills/flow-compare/
.claude/skills/flow-compare/*
!.claude/skills/flow-compare/skill.md

# GitHub Actions
!.github/
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/*.yml

# Helper-Scripts
!helpers/
helpers/*
!helpers/generate-docs-screenshots.js

# Beispiel-Reports
!examples/
examples/*
!examples/*.md

# Dokumentations-Bilder
!images/
images/*
!images/*.png